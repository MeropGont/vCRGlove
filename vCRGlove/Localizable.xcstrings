    "instructions.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Thema für eine einfache Schritt-für-Schritt-Anleitung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a topic for simple, step-by-step guidance."
          }
        }
      }
    },
    "instructions.journal.step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie das Journal und wählen Sie im Kalender das heutige Datum aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Journal and select today's date in the calendar."
          }
        }
      }
    },
    "instructions.journal.step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllen Sie die tägliche Abfrage aus, um festzuhalten, wie Sie sich heute fühlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the daily check-in to record how you feel today."
          }
        }
      }
    },
    "instructions.journal.step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassen Sie bei Bedarf Medikamente, eine Symptomepisode oder eine Notiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add medication, a symptom episode, or a note whenever needed."
          }
        }
      }
    },
    "instructions.journal.step4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie für eine Symptomepisode vor dem Speichern sowohl das Symptom als auch seine Stärke aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a symptom episode, choose both the symptom and its intensity before saving."
          }
        }
      }
    },
    "instructions.journal.step5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie, ob der gespeicherte Eintrag unter dem ausgewählten Datum erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that the saved entry appears under the selected date."
          }
        }
      }
    },
    "instructions.journal.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Symptome, Medikamente und Notizen erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record daily symptoms, medication, and notes"
          }
        }
      }
    },
    "instructions.journal.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the journal"
          }
        }
      }
    },
    "instructions.movement.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie das iPhone ruhig und achten Sie darauf, dass die Hand oder Apple Watch während der gesamten Aufnahme erkannt bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the iPhone stable and make sure the hand or Apple Watch remains detected throughout the recording."
          }
        }
      }
    },
    "instructions.movement.step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Bewegung und wählen Sie aus, wann die Messung durchgeführt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Movement and choose when the measurement is being taken."
          }
        }
      }
    },
    "instructions.movement.step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Bewegungsaufgabe und die Hand aus, die Sie messen möchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the movement task and the hand you want to measure."
          }
        }
      }
    },
    "instructions.movement.step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie bei Kameraaufgaben Ihre ganze Hand in den Bildausschnitt und folgen Sie der Anweisung auf dem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For camera tasks, place your whole hand in the frame and follow the instruction on screen."
          }
        }
      }
    },
    "instructions.movement.step4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie für Pronation und Supination die Apple Watch auf der gemessenen Seite und lassen Sie die Watch-App geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For pronation and supination, wear the Apple Watch on the measured side and keep the Watch app open."
          }
        }
      }
    },
    "instructions.movement.step5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie den Countdown ab und führen Sie die Bewegung aus, bis die Aufnahme beendet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the countdown, then perform the movement until the recording finishes."
          }
        }
      }
    },
    "instructions.movement.step6": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie das Ergebnis. Wiederholen Sie die Aufgabe, wenn die Aufnahme fehlgeschlagen ist oder kein verwertbares Signal enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the result. Repeat the task if the recording failed or contains no usable signal."
          }
        }
      }
    },
    "instructions.movement.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera oder Apple Watch vorbereiten und eine Aufgabe aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare the camera or Apple Watch and record a task"
          }
        }
      }
    },
    "instructions.movement.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegungsaufgaben durchführen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete movement tasks"
          }
        }
      }
    },
    "instructions.step.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritt %d: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %d: %@"
          }
        }
      }
    },
    "instructions.steps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps"
          }
        }
      }
    },
    "instructions.topics": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topics"
          }
        }
      }
    },
    "instructions.vcr.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich der Fingertest falsch anfühlt oder die Stimulation unangenehm ist, beenden Sie die Sitzung und kontaktieren Sie den ICNS-Support."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the fingertip check feels wrong or stimulation is uncomfortable, stop the session and contact ICNS support."
          }
        }
      }
    },
    "instructions.vcr.step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie die Handschuhe, die Sie verwenden möchten. Mindestens ein Handschuh muss Bereit anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the gloves you will use. At least one glove must show Ready."
          }
        }
      }
    },
    "instructions.vcr.step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Start und folgen Sie dem Fingertest, bevor die Stimulation beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Start and follow the finger check before stimulation begins."
          }
        }
      }
    },
    "instructions.vcr.step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie vCRGlove während der Stimulation geöffnet und im Vordergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep vCRGlove open and in the foreground during stimulation."
          }
        }
      }
    },
    "instructions.vcr.step4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Pause und Fortsetzen, wenn Sie eine Unterbrechung benötigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Pause and Resume whenever you need a break."
          }
        }
      }
    },
    "instructions.vcr.step5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Handschuh getrennt wird, läuft der andere weiter. Wenn beide getrennt werden, pausiert die Sitzung, bis ein Handschuh wieder verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If one glove disconnects, the other continues. If both disconnect, the session pauses until a glove reconnects."
          }
        }
      }
    },
    "instructions.vcr.step6": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Sitzung vorzeitig zu beenden, halten Sie Zum Stoppen halten gedrückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To end early, press and hold Hold to Stop."
          }
        }
      }
    },
    "instructions.vcr.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicher starten, pausieren, fortsetzen und beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start, pause, resume, and finish safely"
          }
        }
      }
    },
    "instructions.vcr.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vCR-Sitzung durchführen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete a vCR session"
          }
        }
      }
    },
    "Jeden Tag können Sie einchecken: Stimmung, Symptome, Medikamente und Notizen. Das Journal hilft Ihnen und Ihrem Arzt, Verläufe zu erkennen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Tag können Sie einchecken: Stimmung, Symptome, Medikamente und Notizen. Das Journal hilft Ihnen und Ihrem Arzt, Verläufe zu erkennen."
          }
        },
        "en": {
          "stringUnit": {
