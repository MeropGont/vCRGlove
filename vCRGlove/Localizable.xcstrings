    "Privacy & Data" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz & Daten"
          }
        }
      }
    },
    "privacy.app.faceMasking" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Videos werden auf diesem iPhone auf den erkannten Handbereich zugeschnitten. Kann kein geeigneter Ausschnitt bestimmt werden, wird kein Video gespeichert; die Bewegungsmessungen bleiben erhalten. Erkannte Gesichter werden vor dem Speichern mit undurchsichtigen Flächen verdeckt. Die ungeschützte Zwischenaufnahme wird anschließend gelöscht. Schlägt die Verarbeitung fehl, bleiben nur die Bewegungsmessungen erhalten. Gesichter können übersehen werden; andere erkennbare Merkmale bleiben sichtbar. Dies garantiert keine Anonymität. Ältere Videos bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New videos are cropped to the detected hand area on this iPhone. If a suitable crop cannot be determined, no video is saved; the movement measurements are kept. Detected faces are covered with opaque masks before saving. The unmasked temporary recording is then deleted. If processing fails, only the movement measurements are kept. Faces may be missed and other identifying features remain visible. This does not guarantee anonymity. Older videos remain unchanged."
          }
        }
      }
    },
    "privacy.app.localData" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App speichert Tagebucheinträge, Stimulationsereignisse und Bewegungsmessungen lokal auf diesem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app stores journal entries, stimulation events and movement measurements locally on this iPhone."
          }
        }
      }
    },
    "privacy.app.videoCapture" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Aufnahmen von Finger-Tapping und Handöffnen/-schließen wird auch ein Video ohne Ton gespeichert. Bei der Kalibrierung und bei Watch-Aufgaben wird kein Video gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finger-tapping and hand opening/closing recordings also save a silent video. Calibration and Watch tasks do not save video."
          }
        }
      }
    },
    "privacy.app.videoDeletion" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie ein Video löschen, bleiben die Bewegungsmessungen erhalten. Bereits an anderer Stelle geteilte Kopien werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting a video keeps its movement measurements. Copies you have already shared elsewhere are not deleted."
          }
        }
      }
    },
    "privacy.app.videoSharing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter Einstellungen > Daten können Sie Videos ansehen, teilen oder löschen. Eine Weitergabe erfolgt nur, wenn Sie diese selbst auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can review, share or delete videos in Settings > Data. Sharing happens only when you choose it."
          }
        }
      }
    },
    "privacy.app.videoStorage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos werden im privaten Speicher der App abgelegt. Sie werden nicht automatisch in Fotos gespeichert oder hochgeladen. Sie sind von der automatischen Gerätesicherung ausgeschlossen. Wenn Sie die App löschen oder das Telefon verlieren, können Videos daher verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos are stored privately inside the app. They are not automatically saved to Photos or uploaded. They are excluded from automatic device backup. Deleting the app or losing the phone can therefore cause video loss."
          }
        }
      }
    },
    "privacy.app.videoTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos der Kameraaufgaben"
