    "study.contact.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fragen zur Studie, zu den Geräten oder zu Ihrer Teilnahme nutzen Sie bitte die bestehenden ICNS-Kontaktdaten in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For questions about the study, devices or your participation, use the existing ICNS support contact details in Settings."
          }
        }
      }
    },
