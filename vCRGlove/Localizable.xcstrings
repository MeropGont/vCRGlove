          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den passenden Kontext (z. B. vor oder nach der vCR-Sitzung), drücken Sie Start und folgen Sie der Anleitung. Für manche Tests wird die Kamera verwendet, für andere die Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the appropriate context (e.g., before or after the vCR session), press Start and follow the instructions. Some tests use the camera, others the Apple Watch."
