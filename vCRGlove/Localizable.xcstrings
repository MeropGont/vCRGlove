          }
        }
      }
    },
    "study.privacy.erasure.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Recht auf Löschung Sie betreffender personenbezogener Daten, z. B. wenn diese Daten für den Zweck, für den sie erhoben wurden, nicht mehr notwendig sind (Artikel 17 und 19 DSGVO, §35 BDSG-neu)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the right to erasure of personal data concerning you, for example if those data are no longer necessary for the purpose for which they were collected (Articles 17 and 19 GDPR, Section 35 BDSG-neu)."
          }
        }
      }
    },
    "study.privacy.erasure.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recht auf Löschung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right to erasure"
          }
        }
      }
    },
    "study.privacy.ethics" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Forschungsvorhaben ist durch die zuständige Ethik-Kommission ethisch und fachrechtlich beraten worden und wird unter Beachtung der Deklaration von Helsinki (Erklärung des Weltärztebundes zu den ethischen Grundsätzen für die medizinische Forschung am Menschen) sowie der Leitlinie für Gute Klinische Praxis (GCP) durchgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This research project has undergone ethical and professional-regulatory review by the competent ethics committee and is conducted in accordance with the Declaration of Helsinki (the World Medical Association's declaration on ethical principles for medical research involving human participants) and the Guideline for Good Clinical Practice (GCP)."
          }
        }
      }
    },
    "study.privacy.gdpr" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab dem 25. Mai 2018 trat die Europäische Datenschutz-Grundverordnung (DSGVO) in Kraft. Sie werden im Folgenden über die in der DSGVO festgelegten Rechte informiert (Artikel 12 ff. DSGVO)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The European General Data Protection Regulation (GDPR) entered into force as of 25 May 2018. The following information explains the rights set out in the GDPR (Articles 12 et seq. GDPR)."
          }
        }
      }
    },
    "study.privacy.heading" : {
