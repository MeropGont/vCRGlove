    "Your typical: %@ · %d earlier day(s)" : {
      "extractionState" : "manual",
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your typical: %@ · %d earlier day(s)" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Für Sie typisch: %@ · %d frühere Tage" } } }
    },
    "Your comparison uses daily medians within the selected comparison window. Whole study includes all earlier matching days, independently of the chart period. Other filters apply; each recording day has equal weight." : {
      "extractionState" : "manual",
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your comparison uses daily medians within the selected comparison window. Whole study includes all earlier matching days, independently of the chart period. Other filters apply; each recording day has equal weight." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ihr Vergleich nutzt Tagesmediane im gewählten Vergleichszeitraum. Die gesamte Studie umfasst alle früheren passenden Tage, unabhängig vom Diagrammzeitraum. Andere Filter gelten weiterhin; jeder Aufnahmetag hat das gleiche Gewicht." } } }
    },
    "Preparing video…" : {
