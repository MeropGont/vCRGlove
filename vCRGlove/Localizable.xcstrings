    "study.devices.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Handschuhe geben leichte Vibrationen an die Fingerspitzen ab. Mit der App dokumentieren Sie Ihre Nutzung, Ihr Befinden, Medikamente und Beschwerden. Kurze Bewegungsaufgaben ergänzen diese Angaben. Je nach Studienablauf wird auch eine Smartwatch zur Erfassung von Bewegungsdaten verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gloves deliver gentle vibrations to your fingertips. You use the app to record your glove use, how you feel, medication and symptoms. Short movement tasks complement these entries. Depending on the study procedure, a smartwatch is also used to collect movement data."
          }
        }
      }
    },
    "study.devices.results" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bewegungswerte in der App sind keine ärztliche Beurteilung. Bei Fragen zu Ihren Ergebnissen hilft Ihnen das Studienteam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movement values in the app are not a medical assessment. The study team can help with questions about your results."
          }
        }
      }
    },
    "study.devices.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte und App"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devices and app"
          }
        }
      }
    },
    "study.info.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier finden Sie die wichtigsten Informationen zur vCR-Studie. Diese Übersicht ergänzt das Aufklärungsgespräch und Ihre Studienunterlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key information about the vCR study. This overview supplements your study documents and the discussion with the study team."
          }
        }
      }
    },
    "study.info.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilnahme, Kontakt und Datenschutz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participation, contact and data protection"
          }
        }
      }
    },
    "study.info.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informationen zur Studie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Information about the study"
          }
        }
      }
    },
    "study.participation.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Einweisung verwenden Sie die Studiengeräte zu Hause nach dem mit dem Studienteam vereinbarten Plan. Die häusliche Studienphase dauert bis zu sechs Monate. Dazu kommen Untersuchungstermine und eine Nachbefragung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After your introduction to the devices, you use them at home according to the plan agreed with the study team. The home phase lasts up to six months. There are also examination appointments and a follow-up discussion."
          }
        }
      }
    },
    "study.participation.plan" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre genauen Nutzungszeiten und Termine besprechen Sie mit dem Studienteam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will discuss your exact usage times and appointments with the study team."
          }
        }
      }
    },
    "study.participation.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Teilnahme"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your participation"
          }
        }
      }
    },
    "study.privacy.access.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Recht auf Auskunft über die Sie betreffenden personenbezogenen Daten, die im Rahmen der klinischen Studie erhoben, verarbeitet oder ggf. an Dritte übermittelt werden (Aushändigen einer kostenfreien Kopie) (Artikel 15 DSGVO, §34 BDSG-neu)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the right of access to personal data concerning you that are collected, processed or, where applicable, disclosed to third parties as part of the clinical study (provision of a copy free of charge) (Article 15 GDPR, Section 34 BDSG-neu)."
          }
        }
      }
    },
    "study.privacy.access.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recht auf Auskunft"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right of access"
          }
        }
      }
    },
    "study.privacy.anonymisation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 Anonymisieren ist das Verändern personenbezogener Daten derart, dass die Einzelangaben über persönliche oder sachliche\nVerhältnisse nicht mehr oder nur mit einem unverhältnismäßig großen Aufwand an Zeit, Kosten und Arbeitskraft einer bestimmten oder bestimmbaren natürlichen Person zugeordnet werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 Anonymisation means altering personal data in such a way that individual details concerning personal or material circumstances can no longer, or only with a disproportionately large expenditure of time, costs and labour, be attributed to a particular or identifiable natural person."
          }
        }
      }
    },
    "study.privacy.authority" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz-Aufsichtsbehörde\nDer Landesbeauftragte für den Datenschutz Hamburg\nLudwig-Erhard-Str.22\n20459\n040 / 42854 - 4040\nmailbox@datenschutz.hamburg.de"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Protection Supervisory Authority\nHamburg Commissioner for Data Protection\nLudwig-Erhard-Str.22\n20459\n040 / 42854 - 4040\nmailbox@datenschutz.hamburg.de"
          }
        }
      }
    },
    "study.privacy.basis.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rechtsgrundlage zur Verarbeitung der Sie betreffenden personenbezogenen Daten bildet bei klinischen Studien Ihre freiwillige schriftliche Einwilligung gemäß DSGVO. Zeitgleich mit der DSGVO trat in Deutschland das überarbeitete Bundesdatenschutzgesetz (BDSG-neu) in Kraft. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In clinical studies, the legal basis for processing personal data concerning you is your voluntary written consent under the GDPR. The revised Federal Data Protection Act (BDSG-neu) entered into force in Germany at the same time as the GDPR."
          }
        }
      }
    },
    "study.privacy.basis.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsgrundlage"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legal basis"
          }
        }
      }
    },
    "study.privacy.complaint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerdem haben Sie das Recht, Beschwerde bei der/den Aufsichtsbehörde/n einzulegen, wenn Sie der Ansicht sind, dass die Verarbeitung der Sie betreffenden personenbezogenen Daten gegen die DS-GVO verstößt:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You also have the right to lodge a complaint with the supervisory authority or authorities if you consider that the processing of personal data concerning you infringes the GDPR:"
          }
        }
      }
    },
    "study.privacy.confidentiality" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die im Rahmen des Forschungsvorhabens nach Einwilligungserklärung der Studienteilnehmenden erhobenen persönlichen Daten, insbesondere Befunde, unterliegen der Schweigepflicht und den datenschutzgesetzlichen Bestimmungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal data collected as part of the research project after the study participants have given their declaration of consent, in particular findings, are subject to the duty of confidentiality and data protection legislation."
          }
        }
      }
    },
    "study.privacy.contacts.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz: Kontaktdaten der Aufsicht der Studienleitung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data protection: contact details for supervision of the study leadership"
          }
        }
      }
    },
    "study.privacy.definitions.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
