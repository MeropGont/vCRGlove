    "Im Kalender sehen Sie auf einen Blick, an welchen Tagen Sie ein Journal geschrieben oder einen Bewegungstest gemacht haben. Ein dunkelgrüner Kreis bedeutet: An diesem Tag gibt es Messdaten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Kalender sehen Sie auf einen Blick, an welchen Tagen Sie ein Journal geschrieben oder einen Bewegungstest gemacht haben. Ein dunkelgrüner Kreis bedeutet: An diesem Tag gibt es Messdaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the calendar you can see at a glance on which days you wrote a journal or did a movement test. A dark green circle means: There is measurement data on this day."
          }
        }
      }
    },
    "Instruction video for %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anleitungsvideo für %@"
          }
        }
      }
    },
    "instructions.gloves.step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie beide Handschuhe vor dem Start auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge both gloves before starting."
          }
        }
      }
    },
    "instructions.gloves.step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie jeden Handschuh an der passenden Hand an und schließen Sie ihn bequem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put each glove on the matching hand and fasten it comfortably."
          }
        }
      }
    },
    "instructions.gloves.step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die Handschuhe ein und öffnen Sie anschließend den vCR-Tab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the gloves, then open the vCR tab."
          }
        }
      }
    },
    "instructions.gloves.step4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Handschuhe suchen und warten Sie, bis jeder verfügbare Handschuh Bereit und einen Batteriestand anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Scan for gloves and wait until each available glove shows Ready and a battery level."
          }
        }
      }
    },
    "instructions.gloves.step5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Handschuh fehlt, schalten Sie ihn aus und wieder ein, halten Sie ihn nahe am iPhone und suchen Sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a glove is missing, turn it off and on, keep it near the iPhone, and scan again."
          }
        }
      }
    },
    "instructions.gloves.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, suchen und Verbindung prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on, scan, and check the connection"
          }
        }
      }
    },
    "instructions.gloves.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschuhe verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the gloves"
          }
        }
      }
    },
