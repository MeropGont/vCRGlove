          }
        }
      }
    },
    "study.privacy.keyFile" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zuordnungsliste (Schlüsseldatei) wird getrennt von den Studiendaten und besonders gesichert aufbewahrt. Der Zugriff ist auf die Studienleitung und autorisierte Personen beschränkt. Nach Abschluss der Studie und spätestens 10 Jahre nach Studienende wird die Schlüsseldatei gelöscht, sodass die Daten dauerhaft anonymisiert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The linkage list (key file) is kept separately from the study data and is subject to special security measures. Access is restricted to the study leadership and authorised persons. After the study has been completed, and no later than 10 years after its end, the key file will be deleted so that the data are permanently anonymised."
          }
        }
      }
    },
    "study.privacy.objection.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Recht, jederzeit gegen konkrete Entscheidungen oder Maßnahmen zur Verarbeitung der Sie betreffenden personenbezogenen Daten Widerspruch einzulegen (Art 21 DSGVO, § 36BDSG-neu). Eine solche Verarbeitung findet anschließend grundsätzlich nicht mehr statt. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the right to object at any time to specific decisions or measures concerning the processing of personal data relating to you (Article 21 GDPR, Section 36 BDSG-neu). As a rule, such processing will then cease."
          }
        }
      }
    },
    "study.privacy.objection.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widerspruchsrecht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right to object"
          }
        }
      }
    },
    "study.privacy.portability.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Recht, die Sie betreffenden personenbezogenen Daten, die Sie den Verantwortlichen für die klinische Studie bereitgestellt haben, zu erhalten. Damit können Sie beantragen, dass diese Daten entweder Ihnen oder, soweit technisch möglich, einer anderen von Ihnen benannten Stelle übermittelt werden (Artikel 20 DSGVO)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the right to receive the personal data concerning you that you have provided to the controllers for the clinical study. You may therefore request that these data be transmitted either to you or, where technically feasible, to another body designated by you (Article 20 GDPR)."
          }
        }
      }
    },
    "study.privacy.portability.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recht auf Datenübertragbarkeit "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right to data portability"
          }
        }
      }
    },
    "study.privacy.pseudonymisation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Pseudonymisieren ist das Ersetzen des Namens und anderer Identifikationsmerkmale durch ein Kennzeichen zu dem Zweck, die Identifizierung des Betroffenen auszuschließen oder wesentlich zu erschweren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Pseudonymisation means replacing the name and other identifying characteristics with an identifier in order to prevent or substantially impede identification of the data subject."
          }
        }
      }
    },
    "study.privacy.rectification.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Recht, Sie betreffende unrichtige personenbezogene Daten berichtigen zu lassen (Artikel 16 und 19 DSGVO)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the right to have inaccurate personal data concerning you rectified (Articles 16 and 19 GDPR)."
          }
        }
      }
    },
    "study.privacy.rectification.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recht auf Berichtigung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right to rectification"
          }
        }
      }
    },
    "study.privacy.responsible.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die o.g. Studie besteht die verantwortliche Studienleitung des Universitätsklinikums Hamburg-Eppendorf aus Prof. Dr. Claus C. Hilgetag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person responsible for leading the above-mentioned study at the University Medical Center Hamburg-Eppendorf is Prof. Dr. Claus C. Hilgetag."
          }
        }
      }
    },
    "study.privacy.responsible.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Datenverarbeitung verantwortliche Person"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Person responsible for data processing"
          }
        }
      }
    },
    "study.privacy.restriction.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter bestimmten Voraussetzungen haben Sie das Recht, eine Einschränkung der Verarbeitung zu verlangen, d.h. die Daten dürfen nur gespeichert, aber nicht verarbeitet werden. Dies müssen Sie beantragen. Wenden Sie sich hierzu bitte an Ihre Studienleitung oder an den Datenschutzbeauftragten des Prüfzentrums (Artikel 18 und 19 DSGVO)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under certain conditions, you have the right to request restriction of processing, meaning that the data may only be stored, not processed. You must apply for this. Please contact your study leadership or the data protection officer at the study site (Articles 18 and 19 GDPR)."
          }
        }
      }
    },
    "study.privacy.restriction.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recht auf Einschränkung der Verarbeitung "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right to restriction of processing"
          }
        }
      }
    },
    "study.privacy.storage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die übrigen im Rahmen der Studie erhobenen Daten werden in Papierform und auf Datenträgern am UKE aufgezeichnet und pseudonymisiert (verschlüsselt) für die Dauer von 10 Jahren gespeichert. Bei der Pseudonymisierung (Verschlüsselung) werden der Name und andere Identifikationsmerkmale (z.B. Teile des Geburtsdatums) z.B. durch eine mehrstellige Buchstaben- oder Zahlenkombination, auch Code genannt, ersetzt, um die Identifizierung der Studienteilnehmenden auszuschließen oder wesentlich zu erschweren. Zugang zu dem „Schlüssel“, der eine persönliche Zuordnung der Studiendaten ermöglicht, haben ausschließlich die Studienleitung sowie von ihr ausdrücklich berechtigte Personen. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remaining data collected as part of the study are recorded on paper and on data storage media at UKE and stored in pseudonymised (encrypted) form for a period of 10 years. In pseudonymisation (encryption), the name and other identifying characteristics (e.g. parts of the date of birth) are replaced, for example, by a combination of several letters or numbers, also called a code, in order to prevent or substantially impede identification of study participants. Access to the ‘key’, which allows study data to be linked to an individual, is restricted to the study leadership and persons expressly authorised by it."
          }
        }
      }
    },
    "study.privacy.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data protection"
          }
        }
      }
    },
    "study.privacy.use" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswertung und Nutzung der Daten durch die Studienleitung und ihre Mitarbeitenden erfolgt in pseudonymisierter Form. Eine Weitergabe der erhobenen Daten im Rahmen des Forschungszwecks erfolgt nur in anonymisierter Form. Gleiches gilt für die Veröffentlichung der Studienergebnisse. Eine Weitergabe personenbezogener Daten an Dritte erfolgt nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The study leadership and its staff analyse and use the data in pseudonymised form. Data collected for the purposes of the research are disclosed only in anonymised form. The same applies to publication of the study results. Personal data are not disclosed to third parties."
          }
        }
      }
    },
    "study.privacy.version" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version 02 vom 14.04.2026"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version 02 dated 14 April 2026"
          }
        }
      }
    },
    "study.privacy.withdrawal.basis" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verarbeitung Ihrer personenbezogenen Daten ist nur mit Ihrer Einwilligung rechtmäßig (Artikel 6 DSGVO)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processing your personal data is lawful only with your consent (Article 6 GDPR)."
          }
        }
      }
    },
    "study.privacy.withdrawal.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Recht, Ihre Einwilligung zur Verarbeitung personenbezogener Daten jederzeit zu widerrufen. Im Falle des Widerrufs müssen Ihre personenbezogenen Daten grundsätzlich gelöscht werden (Artikel 7, Absatz 3 DSGVO). Es gibt allerdings Ausnahmen, nach denen die bis zum Zeitpunkt des Widerrufs erhobenen Daten weiterverarbeitet werden dürfen, z.B. wenn die weitere Datenverarbeitung zur Erfüllung einer rechtlichen Verpflichtung erforderlich ist (Art. 17 Abs. 3 b DSGVO)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the right to withdraw your consent to the processing of personal data at any time. If you withdraw your consent, your personal data must, in principle, be erased (Article 7(3) GDPR). There are, however, exceptions under which data collected up to the time of withdrawal may continue to be processed, for example where further processing is necessary to comply with a legal obligation (Article 17(3)(b) GDPR)."
          }
        }
      }
    },
    "study.privacy.withdrawal.contact" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie eines dieser Rechte in Anspruch nehmen, wenden Sie sich bitte an die Studienleitung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you wish to exercise any of these rights, please contact the study leadership."
          }
        }
      }
    },
    "study.privacy.withdrawal.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einwilligung zur Verarbeitung personenbezogener Daten und Recht auf Widerruf dieser Einwilligung "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consent to the processing of personal data and the right to withdraw that consent"
          }
        }
      }
    },
    "study.safety.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzung und die zusätzlichen Angaben in der App benötigen Zeit. Beim Tragen der Handschuhe können vorübergehend Hautreizungen, Druckgefühl oder Ermüdung der Hände auftreten. Wenn Beschwerden auftreten oder die Nutzung unangenehm ist, unterbrechen Sie die Anwendung und sprechen Sie mit dem Studienteam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using the devices and making entries in the app takes time. Wearing the gloves may cause temporary skin irritation, pressure or hand fatigue. If you develop discomfort or find the gloves unpleasant to use, stop using them and speak to the study team."
          }
        }
      }
    },
    "study.safety.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheit und freiwillige Teilnahme"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safety and voluntary participation"
          }
        }
      }
    },
    "study.safety.voluntary" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Teilnahme ist freiwillig. Sie können Ihre Einwilligung jederzeit ohne Angabe von Gründen widerrufen. Dadurch entstehen Ihnen keine Nachteile für Ihre medizinische Versorgung. Wenden Sie sich dafür an das Studienteam. Informationen zum Umgang mit bereits erhobenen Daten finden Sie unter Datenschutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participation is voluntary. You may withdraw your consent at any time without giving a reason. This will not disadvantage you in your medical care. To do so, contact the study team. Information about data already collected is provided under Data protection."
          }
        }
      }
    },
    "study.study.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Pilotstudie am Universitätsklinikum Hamburg-Eppendorf (UKE) untersuchen wir, wie gut sich vibrierende Handschuhe im Alltag von Menschen mit Parkinson nutzen lassen. Im Mittelpunkt stehen Handhabung, Alltagstauglichkeit und Ihre Erfahrungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this pilot study at the University Medical Center Hamburg-Eppendorf (UKE), we are investigating how well vibrating gloves can be used in the everyday lives of people with Parkinson's. Our focus is on handling, everyday usability and your experiences."
          }
        }
      }
    },
